<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ title }} | casruta</title>

    {# ── SEO + social cards ── #}
    {% set pageDesc = subtitle or site.description %}
    {% set pageUrl = site.url + page.url %}
    {% set isPost = tags and "post" in tags %}
    {% set ogImage = "" %}
    {% if thumbnail %}
      {% set ogImage = thumbnail if "://" in thumbnail else site.url + thumbnail %}
    {% endif %}
    <meta name="description" content="{{ pageDesc }}" />
    <meta name="author" content="{{ site.author }}" />
    <link rel="canonical" href="{{ pageUrl }}" />
    <meta property="og:site_name" content="{{ site.title }}" />
    <meta property="og:title" content="{{ title }}" />
    <meta property="og:description" content="{{ pageDesc }}" />
    <meta property="og:url" content="{{ pageUrl }}" />
    <meta property="og:type" content="{{ "article" if isPost else "website" }}" />
    {% if isPost %}
      <meta property="article:published_time" content="{{ page.date | htmlDateString }}" />
    {% endif %}
    {% if ogImage %}
      <meta property="og:image" content="{{ ogImage }}" />
      <meta name="twitter:card" content="summary_large_image" />
    {% else %}
      <meta name="twitter:card" content="summary" />
    {% endif %}
    <meta name="twitter:title" content="{{ title }}" />
    <meta name="twitter:description" content="{{ pageDesc }}" />
    <link rel="alternate" type="application/atom+xml" title="casruta feed" href="/feed.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Domine:wght@400;500;600;700&family=Libre+Franklin:ital,wght@0,400;0,500;0,600;0,700;1,400&family=UnifrakturMaguntia&display=swap" />
    <link rel="stylesheet" href="/css/tokens.css?v={{ build }}" />
    <link rel="stylesheet" href="/css/style.css?v={{ build }}" />
    <noscript>
      {# Scroll-reveal hides blocks until JS runs; keep everything visible without JS #}
      <style>.fade-target { opacity: 1 !important; transform: none !important; }</style>
    </noscript>
  </head>
  <body>
    <header class="top-bar">
      <a class="site-badge" href="/">Casruta</a>
    </header>
    <nav class="tabs" aria-label="Site sections">
      <a href="/" {% if page.url == "/" %}class="tab-active" aria-current="page"{% endif %}>Posts</a>
      <a href="/archive/" {% if page.url == "/archive/" %}class="tab-active" aria-current="page"{% endif %}>Archive</a>
      <a href="/tags/" {% if "/tags/" in page.url %}class="tab-active" aria-current="page"{% endif %}>Tags</a>
      <a href="/about/" {% if page.url == "/about/" %}class="tab-active" aria-current="page"{% endif %}>About</a>
    </nav>
    <div class="progress-bar" aria-hidden="true"></div>
    <main id="main-content">
      {{ content | safe }}
    </main>
    <footer>
      <p>&copy; {{ year }} Kacper Ruta</p>
    </footer>

    <script src="/js/main.js?v={{ build }}"></script>
  </body>
</html>
