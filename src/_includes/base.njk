<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ title }} | casruta</title>

    {# ── SEO + social cards ── #}
    {% set pageDesc = subtitle or site.description %}
    {% set pageUrl = site.url + page.url %}
    {% set isPost = tags and "post" in tags %}
    {% set ogImage = "" %}
    {% if thumbnail %}
      {% set ogImage = thumbnail if "://" in thumbnail else site.url + thumbnail %}
    {% endif %}
    <meta name="description" content="{{ pageDesc }}" />
    <meta name="author" content="{{ site.author }}" />
    <link rel="canonical" href="{{ pageUrl }}" />
    <meta property="og:site_name" content="{{ site.title }}" />
    <meta property="og:title" content="{{ title }}" />
    <meta property="og:description" content="{{ pageDesc }}" />
    <meta property="og:url" content="{{ pageUrl }}" />
    <meta property="og:type" content="{{ "article" if isPost else "website" }}" />
    {% if isPost %}
      <meta property="article:published_time" content="{{ page.date | htmlDateString }}" />
    {% endif %}
    {% if ogImage %}
      <meta property="og:image" content="{{ ogImage }}" />
      <meta name="twitter:card" content="summary_large_image" />
    {% else %}
      <meta name="twitter:card" content="summary" />
    {% endif %}
    <meta name="twitter:title" content="{{ title }}" />
    <meta name="twitter:description" content="{{ pageDesc }}" />
    <link rel="alternate" type="application/atom+xml" title="casruta feed" href="/feed.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,800;1,400&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap" />
    <link rel="stylesheet" href="/css/tokens.css?v={{ build }}" />
    <link rel="stylesheet" href="/css/style.css?v={{ build }}" />
    <noscript>
      {# Scroll-reveal hides blocks until JS runs; keep everything visible without JS #}
      <style>.fade-target { opacity: 1 !important; transform: none !important; }</style>
    </noscript>
  </head>
  <body>
    <header>
      <a class="site-title" href="/">casruta</a>
      <nav>
        <a href="/">Writing</a>
        <a href="/archive/">Archive</a>
        <a href="/about/">About</a>
      </nav>
    </header>
    <div class="progress-bar" aria-hidden="true"></div>
    <main id="main-content">
      {{ content | safe }}
    </main>
    <footer>
      <p>&copy; {{ year }} Kacper Ruta</p>
    </footer>

    {# ── Social icons — fixed right side ── #}
    <nav class="social-sidebar" aria-label="Social links">
      <a href="{{ site.social.twitter }}" target="_blank" rel="noopener noreferrer" aria-label="X / Twitter" class="social-icon">
        <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </a>
      <a href="{{ site.social.goodreads }}" target="_blank" rel="noopener noreferrer" aria-label="Goodreads" class="social-icon">
        <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M12.876 2C8.621 2 6.168 4.784 6.168 8.37c0 3.588 2.453 6.37 6.708 6.37 4.254 0 4.956-3.45 4.956-3.45h.088s0 .494.044.846c.044.352.044.758.044 1.076 0 3.412-2.232 5.538-5.632 5.538-2.144 0-3.74-.55-4.736-1.166l-.616 1.694c1.232.704 3.036 1.222 5.352 1.222 4.576 0 7.388-2.728 7.388-7.288V2.374h-1.716v2.552h-.088S16.956 2 12.876 2zm.352 1.75c3.168 0 4.604 2.508 4.604 4.62s-1.436 4.62-4.604 4.62-4.604-2.508-4.604-4.62 1.436-4.62 4.604-4.62z"/></svg>
      </a>
      <a href="{{ site.social.rym }}" target="_blank" rel="noopener noreferrer" aria-label="RateYourMusic" class="social-icon">
        <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2zm0 1.5c4.687 0 8.5 3.813 8.5 8.5s-3.813 8.5-8.5 8.5S3.5 16.687 3.5 12 7.313 3.5 12 3.5zm0 3a5.5 5.5 0 100 11 5.5 5.5 0 000-11zm0 1.5a4 4 0 110 8 4 4 0 010-8zm0 2a2 2 0 100 4 2 2 0 000-4z"/></svg>
      </a>
    </nav>

    <script src="/js/main.js?v={{ build }}"></script>
    <script async src="https://platform.twitter.com/widgets.js" charset="utf-8"></script>
  </body>
</html>
