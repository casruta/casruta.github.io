---
layout: base.njk
title: Home
---

<div class="home-main">
  <h1>Posts</h1>
  <p class="home-intro">The writing portfolio of Kacper Ruta — essays, op-eds, and data-driven social commentary.</p>

  {% if collections.post.length == 0 %}
    <p>No posts yet.</p>
  {% else %}
    <input
      class="post-filter"
      type="search"
      placeholder="Filter by title, subtitle, or #hashtag…"
      aria-label="Filter posts"
    />
    <ul class="post-list">
      {% for post in collections.post | reverse %}
        <li data-search="{{ post.data.title }} {{ post.data.subtitle }}{% for t in post.data.hashtags %} #{{ t }}{% endfor %}">
          {% if post.data.heroImage %}
            <a class="post-list-thumb" href="{{ post.url }}">
              <img src="{{ post.data.heroImage }}" alt="" loading="lazy" />
            </a>
          {% endif %}
          <div class="post-list-text">
            <a href="{{ post.url }}">{{ post.data.title }}</a>
            {% if post.data.subtitle %}
              <p class="post-list-subtitle">{{ post.data.subtitle }}</p>
            {% endif %}
            <p class="post-list-meta">
              <time datetime="{{ post.date | htmlDateString }}">
                {{ post.date | readableDate }}
              </time>
              {% for t in post.data.hashtags %}<a class="tag-chip" href="/tags/{{ t | slugifyTag }}/">#{{ t }}</a>{% endfor %}
            </p>
          </div>
        </li>
      {% endfor %}
    </ul>
    <p class="post-filter-empty" hidden>No posts match.</p>
  {% endif %}
</div>
